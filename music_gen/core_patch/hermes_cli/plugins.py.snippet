# HERMES-MUSIC-GEN-PATCH-BEGIN plugins
    def register_music_gen_provider(self, provider) -> None:
        """Register a music generation backend."""
        try:
            from agent.music_gen_provider import MusicGenProvider
            from agent.music_gen_registry import register_provider as _register_music_provider
        except ImportError:
            logger.warning("Music Generation core support is not installed; apply music_gen/core_patch first.")
            return
        if not isinstance(provider, MusicGenProvider):
            logger.warning("Plugin '%s' tried to register a music_gen provider that does not inherit from MusicGenProvider. Ignoring.", self.manifest.name)
            return
        _register_music_provider(provider)
        logger.info("Plugin '%s' registered music_gen provider: %s", self.manifest.name, provider.name)
# HERMES-MUSIC-GEN-PATCH-END plugins
